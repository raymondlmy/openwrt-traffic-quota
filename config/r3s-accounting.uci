config accounting 'main'
    # Device groups that can be assigned (space-separated; letters, digits,
    # '_' and '-'). Reports: report_hourly_groups get a per-device hourly grid,
    # report_device_groups a per-device list, all other groups a summary line.
    option groups 'Personal Kids IoT'
    option report_hourly_groups 'Kids'
    option report_device_groups 'IoT'
    # (use 'none' to switch a report list off)
    # Seconds between collector samples and between policy evaluations.
    option interval '60'
    # Days of history kept in the database.
    option retention_days '14'
    # Interfaces to measure between (space-separated names allowed).
    # Empty = auto-detect: LAN from network.lan.device, WAN "pppoe-wan" for
    # PPPoE, otherwise network.wan.device. Run r3s-accounting-render-nft and
    # restart the firewall after changing.
    option lan_device ''
    option wan_device ''
    # Persistent database directory. Must be real storage (SD card, eMMC, USB
    # or SSD), not the flash overlay: the database is written every minute.
    option data_dir '/opt/r3s-accounting/data'
    # AdGuard Home query log for per-site (custom domain) quotas. Empty =
    # auto-detect /opt/adguardhome or /var/lib/adguardhome. Without AdGuard,
    # schedules and whole-device blocks work but per-site quotas never charge.
    option adguard_querylog ''
    # Tether guard: groups (space-separated) whose devices may not share
    # their connection. Forwarded packets from them with TTL/IPv6 hop limit
    # 63 or 127 (a hotspot or tethered client behind the device) are dropped;
    # the device's own traffic (64/128) is untouched. Not lifted by /extend
    # or /game. Empty = off. Mobile-data hotspots never reach the router.
    option tether_guard_groups ''
    # Telegram commands (/block /unblock /extend /status) from the chat in
    # /etc/r3s-accounting/secrets. 1 = on. Set with r3s-telegram-setup
    # schedule --commands on|off or Services > Telegram Reports.
    option telegram_bot '0'
