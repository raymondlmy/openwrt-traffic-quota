#!/bin/sh /etc/rc.common

START=97
USE_PROCD=1

start_service() {
    local querylog interval
    querylog="$(uci -q get r3s-accounting.main.adguard_querylog || true)"
    interval="$(uci -q get r3s-accounting.main.interval || true)"
    case "$interval" in ''|*[!0-9]*) interval=60 ;; esac
    [ "$interval" -ge 10 ] || interval=10
    procd_open_instance
    # Values are passed as $1/$2 to the loop, never interpolated into the script.
    procd_set_param command /bin/sh -c \
        'while true; do /usr/bin/r3s-policy-evaluator ${1:+--adguard-querylog "$1"} >/dev/null 2>&1 || logger -t r3s-policy "policy evaluator failed"; sleep "$2"; done' \
        r3s-policy-evaluator "$querylog" "$interval"
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
