#!/bin/sh /etc/rc.common
# R3S Accounting service v1.2.0
START=95
USE_PROCD=1

start_service() {
    /etc/init.d/r3s-accounting-storage start || {
        logger -t r3s-accounting \
            "ERROR: persistent accounting storage is unavailable"
        return 1
    }

    procd_open_instance
    procd_set_param command /bin/sh -c '
        while true; do
            /usr/bin/python3 /usr/lib/r3s-accounting/collector.py
            sleep 60
        done
    '
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    rm -f /var/run/r3s-accounting.pid
}
