#!/bin/sh /etc/rc.common
# Telegram commands (block / unblock / extend / status). Outbound long polling
# only: no listening port. Runs only when r3s-accounting.main.telegram_bot=1,
# which r3s-telegram-setup schedule --commands on|off (or LuCI) sets.

START=99
USE_PROCD=1

start_service() {
    [ "$(uci -q get r3s-accounting.main.telegram_bot)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/bin/r3s-telegram-bot
    procd_set_param respawn 3600 10 0
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger r3s-accounting
}
