{
  "luci-app-r3s-policy": {
    "description": "Traffic quotas, device policies and Telegram reports",
    "read": {
      "file": {
        "/usr/bin/r3s-policy-ro": [
          "exec"
        ],
        "/usr/bin/r3s-policy-ro *": [
          "exec"
        ],
        "/usr/bin/r3s-telegram-status": [
          "exec"
        ]
      },
      "ubus": {
        "file": [
          "exec"
        ],
        "session": [
          "access"
        ]
      }
    },
    "write": {
      "file": {
        "/usr/bin/r3s-policy": [
          "exec"
        ],
        "/usr/bin/r3s-policy *": [
          "exec"
        ],
        "/usr/bin/r3s-telegram-setup": [
          "exec"
        ],
        "/usr/bin/r3s-telegram-setup *": [
          "exec"
        ],
        "/etc/r3s-accounting/secrets.new": [
          "write"
        ]
      },
      "ubus": {
        "file": [
          "exec",
          "write"
        ]
      }
    }
  }
}
