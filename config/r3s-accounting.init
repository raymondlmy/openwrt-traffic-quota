#!/bin/sh /etc/rc.common
# Traffic accounting collector: samples the nft counters every 'interval' s.
START=95
USE_PROCD=1

start_service() {
    /etc/init.d/r3s-accounting-storage start || {
        logger -t r3s-accounting \
            "ERROR: persistent accounting storage is unavailable"
        return 1
    }

    local interval
    interval="$(uci -q get r3s-accounting.main.interval || true)"
    case "$interval" in ''|*[!0-9]*) interval=60 ;; esac
    [ "$interval" -ge 10 ] || interval=10
    procd_open_instance
    procd_set_param command /bin/sh -c '
        while true; do
            /usr/bin/python3 /usr/lib/r3s-accounting/collector.py
            sleep "$1"
        done
    ' r3s-accounting "$interval"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    rm -f /var/run/r3s-accounting.pid
}
